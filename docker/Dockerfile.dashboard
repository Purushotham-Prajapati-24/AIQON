# CASCADE dashboard (React). nginx serves the static build and proxies /api to the CASCADE API,
# so the session cookie is first-party and the browser never needs CORS.
# Build from the repo root:  docker build -f docker/Dockerfile.dashboard -t cascade-dashboard .

FROM node:22-alpine AS build
WORKDIR /dashboard
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY dashboard/ ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY docker/nginx.dashboard.conf /etc/nginx/templates/default.conf.template
COPY --from=build /dashboard/dist /usr/share/nginx/html
# Where the API lives; the nginx image substitutes it into the template at start.
ENV CASCADE_API_UPSTREAM=http://api:8000
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1
