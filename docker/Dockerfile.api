# CASCADE inference API — multi-stage, non-root, read-only model bundle.
# Build from the repo root:  docker build -f docker/Dockerfile.api -t cascade-api .

# ---- builder: resolve and install dependencies into a venv --------------------------------------
FROM python:3.12-slim AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ src/
# Editable install keeps the src/ layout: the service resolves configs/ and artifacts/ relative to
# the repository root (cascade/serving/app.py -> parents[3]), which must be /app at runtime.
RUN pip install -e .

# ---- runtime -----------------------------------------------------------------------------------
FROM python:3.12-slim AS runtime
# LightGBM needs the OpenMP runtime.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgomp1 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 10001 cascade
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLCONFIGDIR=/tmp/matplotlib \
    CASCADE_ARTIFACTS=/app/artifacts \
    CASCADE_MODEL_VERSION=latest
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY --chown=cascade:cascade pyproject.toml README.md ./
COPY --chown=cascade:cascade src/ src/
COPY --chown=cascade:cascade configs/ configs/
COPY --chown=cascade:cascade artifacts/ artifacts/
USER cascade
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).status == 200 else 1)"
CMD ["uvicorn", "cascade.serving.app:app", "--host", "0.0.0.0", "--port", "8000"]
